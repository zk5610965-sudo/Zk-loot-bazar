                              `👤 Customer Name: ${d.name}\n` +
                              `📞 Contact No: ${d.contact}\n` +
                              `💳 UPI ID: ${d.upi}\n` +
                              `💰 Amount: ₹${d.price} (${payMode})\n` +
                              `📍 Address: ${d.address}\n` +
                              `📅 Date: ${histObj.date}\n\n` +
                              `Verify payment and approve in Admin panel!`;
                    waUrl = `https://wa.me/${adminWhatsApp}?text=` + encodeURIComponent(msg);
                }

                historyList.unshift(histObj);
                localStorage.setItem('zk_history_v15', JSON.stringify(historyList));

                setTimeout(() => {
                    document.getElementById('successOverlay').style.display = 'none';
                    window.open(waUrl, '_blank');
                    switchTab('history');
                }, 1500);
            }, 2000);
        }

        function updateOrderStatus(orderId, newStatus) {
            let h = historyList.find(item => item.id === orderId);
            if(h) {
                h.status = newStatus;
                if(newStatus.includes("Successful") && h.code) {
                    h.status = `✅ Success! Your Code: ${h.code}`;
                }
                localStorage.setItem('zk_history_v15', JSON.stringify(historyList));
                renderHistory();
            }
        }

        function sendCodeViaWhatsApp(code, contact) {
            let text = `🎮 Your Fastest Recharge Play Store Code is: *${code}*\nEnjoy your purchase!`;
            window.open(`https://wa.me/91${contact}?text=` + encodeURIComponent(text), '_blank');
        }

        function renderHistory() {
            let c = document.getElementById('historyListContainer');
            if(historyList.length === 0) {
                c.innerHTML = `<div class="card-box" style="text-align: center; color: #777; padding: 20px;"><p style="font-size:12px;">No history yet.</p></div>`;
                return;
            }
            c.innerHTML = "";
            historyList.forEach(h => {
                let adminApprovalButtons = isAdminLoggedIn ? `
                    <div style="margin-top: 6px; display: flex; gap: 4px; flex-wrap: wrap;">
                        <button onclick="updateOrderStatus(${h.id}, '✅ Payment Successful')" style="font-size:9px; background:#2e7d32; color:white; border:none; padding:3px 6px; border-radius:3px; cursor:pointer;">Approve (Success) ✔️</button>
                        <button onclick="updateOrderStatus(${h.id}, '❌ Payment Not Received / Failed')" style="font-size:9px; background:#e53935; color:white; border:none; padding:3px 6px; border-radius:3px; cursor:pointer;">Reject (Failed) ❌</button>
                    </div>
                ` : '';

                let sendWaBtn = h.code && h.status.includes("Success") ? `
                    <div style="margin-top:6px;">
                        <button onclick="sendCodeViaWhatsApp('${h.code}', '9767136557')" style="font-size:10px; background:#25d366; color:white; border:none; padding:4px 8px; border-radius:4px; cursor:pointer; font-weight:bold;">Send Code via WhatsApp 🟢</button>
                    </div>
                ` : '';

                let statusBg = h.status.includes("Failed") ? "#ffebee" : (h.status.includes("Success") ? "#e8f5e9" : "#fff3cd");
                let statusColor = h.status.includes("Failed") ? "#c62828" : (h.status.includes("Success") ? "#2e7d32" : "#856404");

                c.innerHTML += `
                    <div class="card-box" style="font-size: 12px;">
                        <div style="font-weight: bold; color: #333;">${h.title}</div>
                        <div style="color: #512da8; font-weight: bold; margin-top: 2px;">₹${h.price}</div>
                        <div style="color: #666; font-size: 10px; margin-top: 2px;">📅 ${h.date}</div>
                        <div style="margin-top: 6px; background: ${statusBg}; color: ${statusColor}; padding: 3px 8px; border-radius: 4px; display: inline-block; font-weight: bold; font-size: 10px; border: 1px solid #ffeeba;">${h.status}</div>
                        ${sendWaBtn}
                        ${adminApprovalButtons}
                    </div>
                `;
            });
        }

        function initiateCheckout(itemName, price) {
            let mob = document.getElementById('rechargeMob').value.trim();
            let sim = document.getElementById('operatorSelect').value;
            if(mob.length < 10) {
                alert("Please enter a valid 10-digit mobile number first!");
                document.getElementById('rechargeMob').focus();
                return;
            }
            currentCheckoutItem = {title: `${itemName}`, price: price, mobile: mob, sim: sim};
            document.getElementById('qrItemInfo').innerHTML = `Number: ${mob} (${sim})<br>${currentCheckoutItem.title}<br><b>Amount: ₹${price}</b>`;
            document.getElementById('rechargeModal').style.display = 'none';
            document.getElementById('qrModal').style.display = 'flex';
            startFourMinTimer();
        }

        function buyVoucher(vName, price) {
            let mob = "N/A";
            currentCheckoutItem = {title: `${vName} Voucher`, price: price, mobile: mob, sim: "Voucher"};
            document.getElementById('qrItemInfo').innerHTML = `${currentCheckoutItem.title}<br><b>Amount: ₹${price}</b>`;
            document.getElementById('qrModal').style.display = 'flex';
            startFourMinTimer();
        }

        function startFourMinTimer() {
            clearInterval(timerInterval);
            let timeLeft = 240;
            let timerEl = document.getElementById('timerDisplay');
            
            timerInterval = setInterval(() => {
                let m = Math.floor(timeLeft / 60);
                let s = timeLeft % 60;
                timerEl.innerText = `${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;
                if(timeLeft <= 0) {
                    clearInterval(timerInterval);
                    alert("⏱️ Payment time expired!");
                    document.getElementById('qrModal').style.display = 'none';
                }
                timeLeft--;
            }, 1000);
        }

        function confirmPaymentAndSendWhatsApp() {
            clearInterval(timerInterval);
            document.getElementById('qrModal').style.display = 'none';
            
            playSuccessChime();
            document.getElementById('successOverlay').style.display = 'flex';

            let histObj = {
                id: Date.now(),
                title: `${currentCheckoutItem.title} - ${currentCheckoutItem.mobile} (${currentCheckoutItem.sim})`,
                price: currentCheckoutItem.price,
                date: new Date().toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }),
                status: "⏳ Wait Few Minutes (Verification in Progress)"
            };
            historyList.unshift(histObj);
            localStorage.setItem('zk_history_v15', JSON.stringify(historyList));
            
            let adminWhatsApp = "919767136557"; 
            let msg = `⚡ NEW RECHARGE / ORDER RECEIVED!\n\n` +
                      `📱 Mobile Number: ${currentCheckoutItem.mobile}\n` +
                      `📶 Sim Operator: ${currentCheckoutItem.sim}\n` +
                      `📦 Plan/Item: ${currentCheckoutItem.title}\n` +
                      `💰 Amount Paid: ₹${currentCheckoutItem.price}\n` +
                      `📅 Date: ${histObj.date}\n\n` +
                      `Please verify payment and process recharge!`;

            let waUrl = `https://wa.me/${adminWhatsApp}?text=` + encodeURIComponent(msg);

            setTimeout(() => {
                document.getElementById('successOverlay').style.display = 'none';
                window.open(waUrl, '_blank');
                switchTab('history');
            }, 1500);
        }

        function verifyAdmin() {
            let pass = document.getElementById('adminPassInput').value.trim();
            if(pass === "zkadmin123" || pass === "zkadmin") {
                isAdminLoggedIn = true;
                document.getElementById('adminControlsArea').style.display = 'block';
                document.getElementById('priceCableJio').value = cablePrices["JioFiber TV"] || 600;
                document.getElementById('priceCableAirtel').value = cablePrices["Airtel Digital TV"] || 650;
                document.getElementById('priceCableTata').value = cablePrices["Tata Play HD"] || 700;
                document.getElementById('priceCableSun').value = cablePrices["Sun Direct"] || 500;
                document.getElementById('priceCableDish').value = cablePrices["D2H / Dish TV"] || 550;
                alert("🔓 Admin Unlocked!");
            } else {
                alert("❌ Incorrect Password!");
            }
        }

        function shareOnWhatsapp() {
            let currentUrl = window.location.origin + window.location.pathname;
            let refCode = "zk_ref_" + Math.floor(100000 + Math.random() * 900000);
            let shareText = `🎁 Get ₹25 Instant Cashback!\nUse this Fastest Recharge App:\n${currentUrl}?ref=${refCode}`;
            window.open(`https://wa.me/?text=` + encodeURIComponent(shareText), '_blank');
        }
    </script>

